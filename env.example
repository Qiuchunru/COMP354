# AI Configuration
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# Sponsors data
SPONSOR_CSV_PATH=data/sponsors.csv

# Pipeline settings
MIN_OVERALL_SCORE=6.0
MAX_CRAWL_PAGES=50
MAX_EMAILS_PER_SITE=5

# Discovery
MLH_EVENTS_URL=https://www.mlh.io/seasons/2026/events

# List of hackathon URLs to crawl for sponsors (one per line)
HACKATHON_URLS_FILE=data/hackathon_urls.txt

# Path where scrape activity is logged.
SCRAPE_LOG_PATH=log.txt

