# Hack Canada Sponsor Research Pipeline — Environment Variables
# -------------------------------------------------------------

# AI LLM Provider
# Choose which AI provider to use (anthropic, openai, google) and set the API key to the chosen provider only.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GOOGLE_API_KEY=your-google-key-here

# Default models (can be overridden):
# anthropic=claude-sonnet-4-6
# openai=gpt-4o-mini
# google=gemini-2.0-flash
# LLM_MODEL=claude-sonnet-4-6

# ----------------------------------------

# Sponsors data
SPONSOR_DB_PATH=data/sponsors.db

# ----------------------------------------

# Pipeline settings
MIN_OVERALL_SCORE=6.0
MAX_CRAWL_PAGES=50
MAX_EMAILS_PER_SITE=5

# ----------------------------------------

# Discovery
MLH_EVENTS_URL=https://www.mlh.io/seasons/2026/events

# ----------------------------------------

# List of hackathon URLs to crawl for sponsors (one per line)
HACKATHON_URLS_FILE=data/hackathon_urls.txt

# ----------------------------------------

# Path where scrape activity is logged
SCRAPE_LOG_PATH=log.txt

# ----------------------------------------

# EMAIL Generator scripts
SENDER_NAME=your-name-here
SENDER_TITLE=your-title-here
EVENT_NAME=ConUHacks X
EVENT_DATE=January 24-25, 2026
EVENT_VENUE=Concordia University's John Molson Building

# ----------------------------------------